{
  "$schema": "https://json.schemastore.org/tsconfig",
  "_version": "24.0.0",

  "compilerOptions": {
    "target": "es2022",
    "module": "node16",
    "moduleResolution": "node16",
    "paths": {    
      "@/*": ["./src/*"],
    },
    "rootDir": ".",
    "outDir": "./dist",
    "lib": ["ES2022", "ESNext"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowJs": true,
    "forceConsistentCasingInFileNames": true,
    "typeRoots": ["./node_modules/@types", "src/@types"]
  },
  "include": ["src/**/*.ts"]
}
